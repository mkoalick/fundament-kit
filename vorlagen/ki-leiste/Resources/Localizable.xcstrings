    "Hooks not installed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks nicht installiert"
          }
        }
      }
    },
    "Hooks removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks entfernt."
          }
        }
      }
    },
    "Hooks tell the app when a session starts, works, asks you something, and ends. Installing adds entries to %@. Your own hooks stay as they are, and the previous file is kept as a backup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks sagen der App, wann eine Session startet, arbeitet, dich etwas fragt und endet. Die Installation fügt Einträge in %@ hinzu. Eigene Hooks bleiben erhalten, die vorherige Datei wird als Sicherung aufbewahrt."
          }
        }
      }
    },
