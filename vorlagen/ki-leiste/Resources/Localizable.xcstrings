    "Codex sessions are read from the files Codex writes; the app checks which of them a running Codex process has open. codex exec runs are not shown.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex-Sessions werden aus den Dateien gelesen, die Codex schreibt; die App prüft, welche davon ein laufender Codex-Prozess offen hat. codex exec-Läufe werden nicht angezeigt."
          }
        }
      }
    },
