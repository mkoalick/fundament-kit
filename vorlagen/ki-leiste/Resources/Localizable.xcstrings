        }
      }
    },
    "Needs no special permission; the strip simply sits on top of the windows' upper edge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht keine Sonderrechte. Die Leiste liegt über dem oberen Rand der Fenster."
          }
        }
      }
    },
    "Needs the Accessibility permission. Windows move down to clear the strip and return to their place when this is switched off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht die Freigabe „Bedienungshilfen“. Fenster rutschen unter die Leiste und kehren beim Ausschalten zurück."
          }
        }
      }
    },
